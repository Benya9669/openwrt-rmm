#!/bin/sh
set -eu

UCI_CONFIG="${UCI_CONFIG:-rmm-agent}"
SHELL_CONFIG="${SHELL_CONFIG:-/etc/rmm-agent.conf}"

uci_get() {
	uci -q get "$UCI_CONFIG.main.$1" 2>/dev/null || true
}

shell_get() {
	key="$1"
	[ -f "$SHELL_CONFIG" ] || return 0
	sed -n "s/^${key}=\"\(.*\)\"$/\1/p" "$SHELL_CONFIG" | tail -n 1
}

escape_value() {
	printf '%s' "$1" | tr -d '\r\n' | sed 's/[\\`"$]/\\&/g'
}

device_id="$(shell_get DEVICE_ID)"
device_token="$(shell_get DEVICE_TOKEN)"
device_token_epoch="$(shell_get DEVICE_TOKEN_EPOCH)"
[ -n "$device_token_epoch" ] || device_token_epoch="1"
identity_reset="0"
if [ "$(uci_get migration_complete)" != "1" ]; then
	legacy_url="$(shell_get SERVER_URL)"
	if [ -n "$device_id" ] && [ -n "$device_token" ]; then
		[ -z "$legacy_url" ] || uci -q set "$UCI_CONFIG.main.server_url=$legacy_url"
		case "$legacy_url" in http://*) uci -q set "$UCI_CONFIG.main.allow_insecure_http=1" ;; esac
		uci -q set "$UCI_CONFIG.main.enabled=1"
	fi
	uci -q set "$UCI_CONFIG.main.migration_complete=1"
	uci -q commit "$UCI_CONFIG"
fi

server_url="$(uci_get server_url)"
allow_insecure="$(uci_get allow_insecure_http)"
case "$server_url" in
	https://*) ;;
	http://*) [ "$allow_insecure" = "1" ] || exit 1 ;;
	*) exit 1 ;;
esac

if [ "$(uci_get reset_identity)" = "1" ]; then
	device_id=""
	device_token=""
	device_token_epoch="1"
	identity_reset="1"
	uci -q set "$UCI_CONFIG.main.reset_identity=0"
	uci -q commit "$UCI_CONFIG"
fi

enrollment_token="$(uci_get enrollment_token)"
if [ -n "$device_id" ] && [ -n "$device_token" ]; then
	enrollment_token=""
	uci -q delete "$UCI_CONFIG.main.enrollment_token" 2>/dev/null || true
	uci -q commit "$UCI_CONFIG"
fi

tunnel_identity="$(uci_get tunnel_identity_file)"
if [ -z "$tunnel_identity" ] || [ "$tunnel_identity" = "/etc/rmm-agent/tunnel_key" ]; then
	tunnel_identity="/etc/rmm-agent/tunnel_device_key"
	uci -q set "$UCI_CONFIG.main.tunnel_identity_file=$tunnel_identity"
	uci -q commit "$UCI_CONFIG"
fi
tunnel_key_epoch="$(shell_get TUNNEL_KEY_EPOCH)"
[ -n "$tunnel_key_epoch" ] || tunnel_key_epoch="1"
command_signing_public_key="$(shell_get COMMAND_SIGNING_PUBLIC_KEY)"
command_signing_key_id="$(shell_get COMMAND_SIGNING_KEY_ID)"
if [ "$identity_reset" = "1" ]; then
	tunnel_key_epoch="1"
	command_signing_public_key=""
	command_signing_key_id=""
fi
command_state_dir="$(shell_get COMMAND_STATE_DIR)"
[ -n "$command_state_dir" ] || command_state_dir="/etc/rmm-agent/command-state"
recovery_dir="$(shell_get RECOVERY_DIR)"
[ -n "$recovery_dir" ] || recovery_dir="/etc/rmm-agent/recovery"

umask 077
temporary="${SHELL_CONFIG}.tmp"
{
	printf 'SERVER_URL="%s"\n' "$(escape_value "$server_url")"
	printf 'ENROLLMENT_TOKEN="%s"\n' "$(escape_value "$enrollment_token")"
	printf 'INTERVAL_SECONDS="%s"\n' "$(escape_value "$(uci_get interval_seconds)")"
	printf 'CHECK_TARGETS="%s"\n' "$(escape_value "$(uci_get check_targets)")"
	printf 'TUNNEL_DEVICE_IDENTITY_FILE="%s"\n' "$(escape_value "$tunnel_identity")"
	printf 'TUNNEL_KEY_EPOCH="%s"\n' "$(escape_value "$tunnel_key_epoch")"
	printf 'COMMAND_SIGNING_PUBLIC_KEY="%s"\n' "$(escape_value "$command_signing_public_key")"
	printf 'COMMAND_SIGNING_KEY_ID="%s"\n' "$(escape_value "$command_signing_key_id")"
	printf 'COMMAND_STATE_DIR="%s"\n' "$(escape_value "$command_state_dir")"
	printf 'RECOVERY_DIR="%s"\n' "$(escape_value "$recovery_dir")"
	printf 'DEVICE_ID="%s"\n' "$(escape_value "$device_id")"
	printf 'DEVICE_TOKEN="%s"\n' "$(escape_value "$device_token")"
	printf 'DEVICE_TOKEN_EPOCH="%s"\n' "$(escape_value "$device_token_epoch")"
} > "$temporary"
chmod 0600 "$temporary"
mv "$temporary" "$SHELL_CONFIG"
