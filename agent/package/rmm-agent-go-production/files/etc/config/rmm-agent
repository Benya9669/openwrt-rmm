config agent 'main'
	option enabled '0'
	option server_url 'https://rmm.example.com'
	option interval_seconds '30'
	option connectivity_check_interval_seconds '300'
	option https_check_urls 'https://detectportal.firefox.com/success.txt https://www.apple.com/library/test/success.html'
	option tunnel_identity_file '/etc/rmm-agent/tunnel_device_key'
	option allow_insecure_http '0'
	option reset_identity '0'
	option migration_complete '0'
