# The default server build only needs Go sources, static UI assets and its public feed key.
**
!go.mod
!go.sum
!internal/**/*.go
!internal/**/*.sql
!server/**/*.go
!server/**/*.sql
!web/*.html
!web/*.js
!web/*.css
!web/*.png
!web/*.svg
!web/*.ico
!web/site.webmanifest
!web/assets/**/*.svg
!web/assets/**/*.png
!web/licenses/*.txt
!keys/openwrt/apk/rmm-openwrt.pem
!deploy/server/entrypoint.sh
